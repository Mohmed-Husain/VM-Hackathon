[Unit]
Description=Smart eVisa FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/VM-Hackathon/backend
EnvironmentFile=/home/ubuntu/VM-Hackathon/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/VM-Hackathon/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
