[Unit]
Description=Smart eVisa FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=evisa
Group=www-data
WorkingDirectory=/srv/evisa/VM-Hackathon/backend
EnvironmentFile=/etc/evisa/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/evisa/VM-Hackathon/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
