# ==============================================================================
# Smart eVisa Portal — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env in your backend or project root directory:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL.
# Supports standard 'postgresql://' or async 'postgresql+asyncpg://'.
# Works with local PostgreSQL, Docker, or managed cloud DBs (Aiven, Supabase, Neon).
#
# Examples:
#   Local DB:
#     DB_URL=postgresql://postgres:postgres@localhost:5432/evisa_db
#   Cloud DB (e.g., Aiven / Supabase with SSL):
#     DB_URL=postgresql://avnadmin:secret_password@pg-service-hostname.aivencloud.com:12345/defaultdb?sslmode=require
DB_URL=postgresql://postgres:postgres@localhost:5432/evisa_db

# Automatically create missing database tables on server startup (set to false in strict production)
AUTO_CREATE_TABLES=true


# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (minimum 32 characters recommended for production)
SECRET_KEY=hackathon-dev-secret-key-change-me-32bytes

# JWT signing algorithm
ALGORITHM=HS256

# JWT access token lifetime in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ------------------------------------------------------------------------------
# 3. APPLICATION & CORS SETTINGS
# ------------------------------------------------------------------------------
# Allowed origins for Cross-Origin Resource Sharing (CORS), separated by commas
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL of the running frontend application
FRONTEND_URL=http://localhost:3000

# Public-facing origin of this backend API (used for document URLs and receipt endpoints)
BACKEND_PUBLIC_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# 4. AI ASSISTANT (OpenAI Integration - Optional)
# ------------------------------------------------------------------------------
# If omitted or left empty, the assistant seamlessly falls back to the deterministic
# rule-based grounding engine using backend/app/data/official_visa_rules.json.
#
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# OpenAI Model identifier (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini


# ------------------------------------------------------------------------------
# 5. FEATURE FLAGS & SIMULATION CONTROLS
# ------------------------------------------------------------------------------
# Toggle simulated payment gateway adapter (default: false in current MVP build)
PAYMENTS_ENABLED=false

